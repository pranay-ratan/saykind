# Copy this file to .env.local and fill in the key. .env.local is git-ignored.
# These values are read on the server only and are never sent to the browser.

# REQUIRED. Create one at https://platform.openai.com/api-keys
# The same key powers speech-to-text, the conversation model and the barista's voice.
OPENAI_API_KEY=

# OPTIONAL. Model names. Providers retire models, so these are configurable.
# Defaults (used if you leave these out):
# OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=cedar

# OPTIONAL. Point at a proxy or compatible gateway instead of api.openai.com.
# OPENAI_BASE_URL=https://api.openai.com/v1

# OPTIONAL. Spending protection for a shared link (see lib/server/guard.ts). Defaults shown.
# RATE_LIMIT_PER_MINUTE=90
# DAILY_LIMIT_PER_CLIENT=600
# HOURLY_LIMIT_GLOBAL=2000
