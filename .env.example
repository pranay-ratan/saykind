# Copy this file to .env.local and fill in the keys you need. .env.local is git-ignored.
# Every value here is read on the server only and is never sent to the browser.
# Format: REQUIRED = the feature will not work without it. OPTIONAL = has a default.

# ---------------------------------------------------------------------------
# SAYKIND CORE (Levels 1, 3 and 4 voice features)
# ---------------------------------------------------------------------------

# REQUIRED for speech-to-text, the conversation model and the barista's voice.
# Create one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OPTIONAL. Model names. Defaults (used if you leave these out):
# OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=cedar

# OPTIONAL. Point at a proxy or compatible gateway instead of api.openai.com.
# OPENAI_BASE_URL=https://api.openai.com/v1

# OPTIONAL. Spending protection for a shared link (see lib/server/guard.ts). Defaults shown.
# RATE_LIMIT_PER_MINUTE=90
# DAILY_LIMIT_PER_CLIENT=600
# HOURLY_LIMIT_GLOBAL=2000

# ---------------------------------------------------------------------------
# LEVEL 2: LIVE CAMERA (/level-2)
# ---------------------------------------------------------------------------

# OPTIONAL. Vision provider: "perceptron" (default) or "gemini" (development fallback only).
VISION_PROVIDER=perceptron

# REQUIRED when VISION_PROVIDER=perceptron. Get one at https://docs.perceptron.inc
PERCEPTRON_API_KEY=

# OPTIONAL. Default perceptron-mk1.5. Try isaac-0.3-fast if latency is high.
PERCEPTRON_MODEL=perceptron-mk1.5

# REQUIRED only when VISION_PROVIDER=gemini. Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OPTIONAL. Default gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# OPTIONAL. Level 2 spoken audio: "browser" (default, no key) or "elevenlabs".
TTS_PROVIDER=browser

# REQUIRED only when TTS_PROVIDER=elevenlabs. Get them at https://elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# OPTIONAL. Enables GET /api/tts?prewarm=1 (header x-prewarm-secret). It spends ElevenLabs credits. Leave empty to keep it closed.
TTS_PREWARM_SECRET=

# OPTIONAL. Level 2 detection budget per session, and default time between live checks (ms).
LIVE_MAX_CALLS=150
LIVE_INTERVAL_MS=1500

# ---------------------------------------------------------------------------
# ADAPTIVE DIFFICULTY (POST /api/adapt)
# ---------------------------------------------------------------------------

# OPTIONAL. "rules" (default, no key needed) or "claude". Claude falls back to the rules on any error.
ADAPTIVE_PROVIDER=rules

# REQUIRED only when ADAPTIVE_PROVIDER=claude. Create one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OPTIONAL. Default claude-haiku-5-5. If Anthropic rejects it, check the models overview and use claude-sonnet-5-5.
CLAUDE_MODEL=claude-haiku-5-5
