# =============================================================================
# Saykind: environment template
# =============================================================================
# 1. Copy this file to .env.local in the project root (next to package.json).
#    .env.local is git-ignored, so keys you paste there are never committed.
# 2. Fill in only the keys for the features you use. Everything marked OPTIONAL has a default.
# 3. Run `npm run check:env` to see which variables are SET or MISSING (values are never printed).
# 4. On Vercel, add the same names under Project > Settings > Environment Variables.
# Keys are read on the server only and are never sent to the browser.
#
# Legend:  REQUIRED = the feature will not work without it.
#          OPTIONAL = has a default; leaving it out is fine.

# -----------------------------------------------------------------------------
# CAFÉ: speech and conversation (Levels 1, 3 and 4 voice features)
# -----------------------------------------------------------------------------

# REQUIRED for spoken audio and speech to text (the café and practice words).
# Needs the Text to Speech and Speech to Text permissions on the key.
# Get one at https://elevenlabs.io (Profile > API keys).
ELEVENLABS_API_KEY=

# OPTIONAL. The café voice. Default: 21m00Tcm4TlvDq8ikWAM (a stock ElevenLabs voice).
# Pick your own in the ElevenLabs voice library and paste its ID here.
ELEVENLABS_VOICE_ID=

# OPTIONAL. Stops spoken audio for the day once this many characters are sent (in memory, resets at UTC midnight).
# Lines past the limit are read by the device voice instead. Default: 30000.
ELEVENLABS_MAX_CHARS_PER_DAY=30000

# REQUIRED for the barista's conversation (Claude is the default when no OpenAI key is set).
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OPTIONAL. Default: claude-haiku-5-5. If Anthropic rejects that name, use claude-sonnet-5-5.
CLAUDE_MODEL=claude-haiku-5-5

# OPTIONAL. Pick the provider per feature: "elevenlabs" or "openai" (speech), "claude" or "openai" (conversation).
# Leave these out to use the defaults: ElevenLabs for speech, Claude for conversation, OpenAI only when no other key is set.
# SPEAK_PROVIDER=elevenlabs
# TRANSCRIBE_PROVIDER=elevenlabs
# CONVERSE_PROVIDER=claude

# OPTIONAL. ElevenLabs speech-to-text model. Default: scribe_v1.
# ELEVENLABS_STT_MODEL=scribe_v1

# OPTIONAL. OpenAI: a fallback only. Used when its key is set and no other provider is available,
# or when a *_PROVIDER variable above asks for it. Nothing breaks when it is empty.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OPTIONAL. OpenAI model names. Defaults shown.
# OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=cedar

# OPTIONAL. Point OpenAI at a proxy or compatible gateway instead of api.openai.com.
# OPENAI_BASE_URL=https://api.openai.com/v1

# OPTIONAL. Spending protection for a shared link (see lib/server/guard.ts). Defaults shown.
# RATE_LIMIT_PER_MINUTE=90
# DAILY_LIMIT_PER_CLIENT=600
# HOURLY_LIMIT_GLOBAL=2000

# -----------------------------------------------------------------------------
# LEVEL 2: live camera (/level-2)
# -----------------------------------------------------------------------------

# OPTIONAL. Vision provider: "perceptron" (default) or "gemini" (development fallback only).
VISION_PROVIDER=perceptron

# REQUIRED when VISION_PROVIDER=perceptron. Get one at https://docs.perceptron.inc
PERCEPTRON_API_KEY=

# OPTIONAL. Default perceptron-mk1.5. Try isaac-0.3-fast if latency is high. Check names in the docs.
PERCEPTRON_MODEL=perceptron-mk1.5

# REQUIRED only when VISION_PROVIDER=gemini. Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OPTIONAL. Default gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# OPTIONAL. Level 2 spoken audio: "browser" (default, no key needed) or "elevenlabs".
TTS_PROVIDER=browser

# OPTIONAL. Enables GET /api/tts?prewarm=1 (send the value in the x-prewarm-secret header).
# That route spends ElevenLabs credits, so it stays closed while this is empty.
# Generate a value with:  openssl rand -hex 16
TTS_PREWARM_SECRET=

# OPTIONAL. Level 2 detection budget per session, and the default time between live checks in milliseconds.
LIVE_MAX_CALLS=150
LIVE_INTERVAL_MS=1500

# -----------------------------------------------------------------------------
# ADAPTIVE DIFFICULTY (POST /api/adapt)
# -----------------------------------------------------------------------------

# OPTIONAL. "rules" (default, no key needed) or "claude". Claude falls back to the rules on any error.
ADAPTIVE_PROVIDER=rules
